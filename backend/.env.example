# Copy to .env and fill in. Never commit the real .env.

# Postgres connection string used by both the app and the Prisma CLI.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mini_social?schema=public"

# Secret used to sign JWTs. Use a long random value in any shared environment.
JWT_SECRET="change-me-to-a-long-random-string"

# Token lifetime, any value the `jsonwebtoken` library accepts (e.g. 15m, 1d, 7d).
JWT_EXPIRES_IN="1d"

# Port the HTTP server listens on.
PORT=4000

# --- Push notifications (optional) ---------------------------------------
# Path to a Firebase service-account JSON file. If neither this nor
# FIREBASE_SERVICE_ACCOUNT_JSON is set, push is disabled and the API runs
# normally — likes and comments still succeed, they just don't notify.
# Keep the referenced file OUT of version control.
FIREBASE_SERVICE_ACCOUNT_PATH="./secrets/firebase-service-account.json"

# Alternative to the path above: the same JSON inlined, for hosts that only
# provide env vars. Takes precedence when both are set.
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
